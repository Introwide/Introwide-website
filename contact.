* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: 'Arial', sans-serif;
  background: #0a1a3a;
  color: #ffffff;
}

header {
  background: #0a1a3a;
  padding: 20px 40px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 2px solid #c9a84c;
}

.logo {
  font-size: 20px;
  font-weight: bold;
  color: #c9a84c;
}

nav a {
  color: #ffffff;
  text-decoration: none;
  margin-left: 20px;
  font-size: 14px;
}

nav a:hover { color: #c9a84c; }

.hero {
  padding: 100px 40px;
  text-align: center;
  background: linear-gradient(135deg, #0a1a3a, #1a2a4a);
}

.hero h1 {
  font-size: 42px;
  color: #c9a84c;
  margin-bottom: 20px;
}

.hero p {
  font-size: 18px;
  max-width: 800px;
  margin: 0 auto 30px;
  line-height: 1.6;
}

.btn {
  display: inline-block;
  background: #c9a84c;
  color: #0a1a3a;
  padding: 15px 40px;
  text-decoration: none;
  font-weight: bold;
  border-radius: 5px;
}

.services {
  padding: 80px 40px;
  background: #0d1f42;
}

.services h2 {
  text-align: center;
  color: #c9a84c;
  font-size: 32px;
  margin-bottom: 50px;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 30px;
  max-width: 1200px;
  margin: 0 auto;
}

.card {
  background: #1a2a4a;
  padding: 30px;
  border-radius: 10px;
  border-top: 3px solid #c9a84c;
}

.card h3 { color: #c9a84c; margin-bottom: 15px; }
.card p { line-height: 1.6; }

footer {
  background: #0a1a3a;
  padding: 40px;
  text-align: center;
  border-top: 2px solid #c9a84c;
}

footer p { margin-bottom: 10px; }
.contact { color: #c9a84c; font-weight: bold; }

@media (max-width: 768px) {
  header { flex-direction: column; gap: 15px; }
  nav a { margin: 0 10px; }
  .hero h1 { font-size: 28px; }
  .hero { padding: 60px 20px; }
}
